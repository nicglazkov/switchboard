# Hosts for the build, test and publish scripts. Copy to ~/.config/switchboard/build-hosts.env (or point
# SWITCHBOARD_BUILD_HOSTS at another file) and fill in your own. Each is an ssh target or a URL; a script only
# asks for the ones it uses, and a variable set in the environment overrides the file.
# The file is sourced by bash, so write NAME=value with no spaces around "=".

# A Mac that builds Switchboard.app (native/scripts/build-mac.sh, mac-shots.sh; iconutil for make-icons.sh).
SB_MAC_BUILD_HOST=you@192.0.2.11

# A Windows machine with MSVC and OpenSSH, whose default ssh shell is PowerShell (native/scripts/build-windows.sh).
SB_WINDOWS_BUILD_HOST=you@192.0.2.12

# A Linux machine with Rust (native/scripts/build-linux.sh, linux-shots.sh; rsvg-convert and Pillow for make-icons.sh).
SB_LINUX_HOST=you@192.0.2.10

# Where scripts/test.sh copies the repo and runs the unit tests (SB_TEST_DIR picks the folder there).
SB_TEST_HOST=you@192.0.2.10

# The machine that runs the Switchboard server and hub (scripts/deploy-server.sh, deploy-hub.sh, shots.sh),
# and the server's address as the apps reach it (shots.sh, e2e.py).
SB_SERVER_HOST=you@192.0.2.10
SB_SERVER_URL=http://192.0.2.10:8130
# Optional: the server's Tailscale address, which the Android app (android/scripts/build.sh) tries when the LAN one
# does not answer.
SB_SERVER_TS_URL=http://100.64.0.10:8130
# The addresses the design lab (design-lab/deploy.sh, on the same machine, port 8133) listens on: a comma list,
# for example the LAN address and the Tailscale one. The lab reads the server at SB_SERVER_URL.
SB_LAB_BIND=192.0.2.10,100.64.0.10

# The server the Linux verification frames read (native/scripts/linux-shots.sh). Only GETs reach it; a fixture
# server (native/scripts/fixture-server.py) is the safe choice. SWITCHBOARD_URL overrides it for one run.
SB_SHOTS_URL=http://192.0.2.10:8139

# Where native/scripts/publish.sh uploads the apps and download page, and the URL that folder is served at.
SB_PUBLISH_HOST=you@192.0.2.10
SB_PUBLISH_BASE=http://192.0.2.10:8133/app
# The URL publish-node.sh checks its files at. Optional: the default is SB_PUBLISH_BASE with /node for its last part.
SB_NODE_BASE=http://192.0.2.10:8133/node

# Updates (docs/building.md, Updates). The public key the apps check the update list with, as
# native/scripts/update-key.sh prints it; a build without it has updates off. Not secret.
SB_UPDATE_PUBKEY=
# The private key file publish.sh signs the list with. Keep it outside the repo.
SB_UPDATE_KEY_FILE=~/.config/switchboard/update-key.pem
# Optional: a URL the apps read latest.json from directly. Without it they ask the server where the page is.
# SB_UPDATE_FEED=http://192.0.2.10:8133/app

# Mac signing (native/scripts/build-dmg.sh). Unset means ad hoc signing only.
# SB_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
# SB_NOTARY_PROFILE=notary
